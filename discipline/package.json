{
  "name": "discipline",
  "version": "1.0.0",
  "description": "DISCIPLINE — 2:30 animated motivational short (Remotion, all-SVG)",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@fontsource/nunito": "5.3.0",
    "@remotion/cli": "4.0.539",
    "@remotion/noise": "4.0.539",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.539",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "docs": "tsx scripts/gen-docs.ts",
    "audio:placeholders": "node scripts/gen-placeholder-audio.mjs",
    "stills": "tsx scripts/render-stills.ts",
    "render": "remotion render Discipline out/discipline_16x9.mp4 --codec=h264 --crf=18",
    "render:vertical": "remotion render Discipline-Vertical out/discipline_9x16.mp4 --codec=h264 --crf=18",
    "render:hooks": "remotion render Hook-A out/hook_A.mp4 --codec=h264 --crf=18 && remotion render Hook-B out/hook_B.mp4 --codec=h264 --crf=18 && remotion render Hook-C out/hook_C.mp4 --codec=h264 --crf=18",
    "render:all": "npm run render && npm run render:vertical && npm run render:hooks"
  },
  "allowScripts": {
    "esbuild": false
  }
}
